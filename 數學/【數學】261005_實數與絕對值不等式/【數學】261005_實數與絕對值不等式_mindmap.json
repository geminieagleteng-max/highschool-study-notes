        {
          "name": "三角不等式",
          "children": [
            {
              "name": "公式：|a| + |b| >= |a + b|"
            },
            {
              "name": "等號成立條件 (|a| + |b| = |a + b|)：ab >= 0（同號或有零）"
            },
            {
              "name": "嚴格大於條件 (|a| + |b| > |a + b|)：ab < 0（異號抵消）"
            },
            {
              "name": "速解應用：求解 |x - a| + |x - b| 的最小值"
            }
          ]
        },
        {
          "name": "還原絕對值不等式格式",
          "children": [
            {
              "name": "已知範圍 -1 <= x <= 9，求出中點 (4) 與半長度 (5)"
            },
            {
              "name": "改寫為 |x - 中點| <= 半長度 格式"
            }
          ]
        }
